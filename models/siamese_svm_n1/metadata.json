{
  "model_type": "Siamese-style pairwise Linear SVM",
  "feature_representation": "absolute_tfidf_difference",
  "feature_count": 30000,
  "class_mapping": {
    "benign": 0,
    "malware": 1
  },
  "pair_label_mapping": {
    "0": "different_class",
    "1": "same_class"
  },
  "selected_k": 3,
  "n_way": 2,
  "aggregation": "mean_pairwise_same_class_decision_score",
  "pair_classifier": {
    "type": "LinearSVC",
    "parameters": {
      "C": 1.0,
      "class_weight": "balanced",
      "max_iter": 20000,
      "random_state": 42
    },
    "classes": [
      0,
      1
    ],
    "decision_score_interpretation": "positive = same class; negative = different class"
  },
  "pair_training": {
    "pairs_per_relation": 20000,
    "same_class_pairs": 20000,
    "different_class_pairs": 20000,
    "total_pairs": 40000,
    "training_samples": 699
  },
  "tfidf": {
    "vocabulary_size": 30000,
    "parameters": {
      "max_features": 30000,
      "ngram_range": [
        1,
        2
      ],
      "lowercase": false,
      "sublinear_tf": true,
      "use_idf": true,
      "norm": "l2",
      "dtype": "<class 'numpy.float32'>",
      "token_pattern": "(?u)\\b[\\w.$:+-]+\\b"
    },
    "fit_partition": "NOT_VERIFIED: confirm vectorizer was fitted on training data only"
  },
  "evaluation": {
    "protocol": "binary_few_shot_episodic",
    "episodes": 100,
    "queries_per_class": 10,
    "k_values": [
      1,
      3,
      5,
      10
    ],
    "validation_seeds": {
      "1": 43,
      "3": 45,
      "5": 47,
      "10": 52
    },
    "test_seed": 1045,
    "support_query_disjoint_within_episode": true,
    "test_samples_reused_across_episodes": true,
    "test_metrics_interpretation": "Mean and standard deviation across episodic evaluations, not one fixed prediction per test sample."
  },
  "validation_results": {
